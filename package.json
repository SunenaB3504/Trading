{
  "name": "trading-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tools/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json}\" \"tools/**/*.ts\"",
    "size": "tsx tools/checkSize.ts",
    "cycles": "depcruise --config .dependency-cruiser.cjs packages",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "simulator": "pnpm --filter @trading/simulator dev",
    "e2e:airplane": "tsx tools/e2e/airplaneMode.ts",
    "e2e:orders": "tsx tools/e2e/orderEntry.ts",
    "e2e:backup": "tsx tools/e2e/backup.ts",
    "e2e:universe": "tsx tools/e2e/universe.ts",
    "e2e:phone": "tsx tools/e2e/phone.ts",
    "e2e:noastro": "tsx tools/e2e/noAstro.ts",
    "e2e:profile": "tsx tools/e2e/profiles.ts",
    "e2e:lots": "tsx tools/e2e/lots.ts",
    "e2e:market": "tsx tools/e2e/realMarket.ts",
    "e2e:stops": "tsx tools/e2e/stopOrders.ts",
    "e2e:funds": "tsx tools/e2e/funds.ts",
    "record:status": "tsx packages/workers/src/recordStatus.ts",
    "pull:bars": "tsx packages/workers/src/pullBars.ts",
    "pull:yahoo": "tsx packages/workers/src/pullYahoo.ts",
    "shortlist": "tsx packages/workers/src/shortlist.ts",
    "crosscheck": "tsx packages/workers/src/crosscheck.ts",
    "buckets": "tsx packages/workers/src/buckets.ts",
    "universe": "tsx packages/workers/src/universe.ts",
    "universe:freeze": "tsx packages/workers/src/freezeUniverse.ts",
    "universe:snapshot": "tsx packages/workers/src/universeSnapshot.ts",
    "market:build": "tsx packages/workers/src/learningMarket.ts",
    "funds:build": "tsx packages/workers/src/learningFunds.ts",
    "market:bundle": "tsx tools/bundleMarket.ts",
    "ots:probe": "tsx packages/workers/src/otsProbe.ts",
    "ots:upgrade": "tsx packages/workers/src/otsUpgrade.ts",
    "ots:verify": "tsx packages/workers/src/otsVerify.ts",
    "register:h21": "tsx packages/research/src/registerH21Cli.ts",
    "run:h21": "tsx packages/research/src/h21RunCli.ts",
    "register:ph12": "tsx packages/research/src/registerPh12Cli.ts",
    "register:dasha": "tsx packages/research/src/registerDashaCollapseCli.ts",
    "run:ph12": "tsx packages/research/src/ph12RunCli.ts",
    "snapshot:publish": "tsx packages/workers/src/publishSnapshot.ts",
    "snapshot:serve": "tsx packages/workers/src/serveSnapshots.ts",
    "uat:start": "tsx tools/uat/start.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm size && pnpm cycles && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
